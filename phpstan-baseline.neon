parameters:
	ignoreErrors:
		-
			message: '#^Access to an undefined property Illuminate\\View\\View\:\:\$definition\.$#'
			identifier: property.notFound
			count: 1
			path: src/Panneau/Composers/AppComposer.php

		-
			message: '#^Access to an undefined property Illuminate\\View\\View\:\:\$props\.$#'
			identifier: property.notFound
			count: 1
			path: src/Panneau/Composers/AppComposer.php

		-
			message: '#^Access to an undefined property Illuminate\\View\\View\:\:\$definition\.$#'
			identifier: property.notFound
			count: 1
			path: src/Panneau/Composers/PanneauComposer.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$request$#'
			identifier: parameter.notFound
			count: 1
			path: src/Panneau/Composers/PanneauComposer.php

		-
			message: '#^Method Panneau\\Legacy\\Fields\\ResourceItems\:\:types\(\) should return array\|null but returns Illuminate\\Support\\Collection\|null\.$#'
			identifier: return.type
			count: 1
			path: src/Panneau/Legacy/Fields/ResourceItems.php

		-
			message: '#^Call to an undefined method Illuminate\\Http\\Request\:\:resource\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Panneau/Http/Controllers/ResourceController.php

		-
			message: '#^Call to an undefined method JsonSerializable\:\:toJson\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Panneau/Http/Controllers/ResourceController.php

		-
			message: '#^Method Panneau\\Http\\Controllers\\ResourceController\:\:create\(\) should return Illuminate\\Http\\Response but returns Illuminate\\View\\View\.$#'
			identifier: return.type
			count: 1
			path: src/Panneau/Http/Controllers/ResourceController.php

		-
			message: '#^Method Panneau\\Http\\Controllers\\ResourceController\:\:destroy\(\) should return Illuminate\\Http\\Response but returns Illuminate\\Http\\JsonResponse\.$#'
			identifier: return.type
			count: 1
			path: src/Panneau/Http/Controllers/ResourceController.php

		-
			message: '#^Method Panneau\\Http\\Controllers\\ResourceController\:\:index\(\) should return Illuminate\\Http\\Response but returns Illuminate\\View\\View\.$#'
			identifier: return.type
			count: 1
			path: src/Panneau/Http/Controllers/ResourceController.php

		-
			message: '#^PHPDoc tag @param for parameter \$request with type Illuminate\\Http\\Request is not subtype of native type Panneau\\Http\\Requests\\ResourceStoreRequest\.$#'
			identifier: parameter.phpDocType
			count: 1
			path: src/Panneau/Http/Controllers/ResourceController.php

		-
			message: '#^PHPDoc tag @param for parameter \$request with type Illuminate\\Http\\Request is not subtype of native type Panneau\\Http\\Requests\\ResourceUpdateRequest\.$#'
			identifier: parameter.phpDocType
			count: 1
			path: src/Panneau/Http/Controllers/ResourceController.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$id$#'
			identifier: parameter.notFound
			count: 6
			path: src/Panneau/Http/Controllers/ResourceController.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 3
			path: src/Panneau/Http/Controllers/ResourceController.php

		-
			message: '#^Call to an undefined method Illuminate\\Http\\Request\:\:isPanneau\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Panneau/Http/Middleware/DispatchHandlingRequestEvent.php

		-
			message: '#^Call to an undefined method Panneau\\Http\\Requests\\ResourceStoreRequest\:\:resource\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Panneau/Http/Requests/ResourceStoreRequest.php

		-
			message: '#^Call to an undefined method Panneau\\Http\\Requests\\ResourceUpdateRequest\:\:resource\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Panneau/Http/Requests/ResourceUpdateRequest.php

		-
			message: '#^Call to preg_quote\(\) is missing delimiter / to be effective\.$#'
			identifier: argument.invalidPregQuote
			count: 2
			path: src/Panneau/Router.php

		-
			message: '#^Call to an undefined method Illuminate\\Http\\Request\:\:isPanneau\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Panneau/ServiceProvider.php

		-
			message: '#^Call to function is_null\(\) with array will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/Panneau/Support/Field.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: src/Panneau/Support/Field.php

		-
			message: '#^Call to function is_null\(\) with array will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/Panneau/Support/Form.php

		-
			message: '#^Variable \$parent in empty\(\) always exists and is always falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/Panneau/Support/LocalizedField.php

		-
			message: '#^Call to function is_null\(\) with array will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/Panneau/Support/Resource.php

		-
			message: '#^Variable \$intl in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.variable
			count: 1
			path: src/Panneau/Support/Resource.php

		-
			message: '#^Access to an undefined property Panneau\\Support\\ResourceType\:\:\$container\.$#'
			identifier: property.notFound
			count: 1
			path: src/Panneau/Support/ResourceType.php

		-
			message: '#^Array has 2 duplicate keys with value ''add_image'' \(''add_image'', ''add_image''\)\.$#'
			identifier: array.duplicateKey
			count: 1
			path: src/lang/en/fields.php

		-
			message: '#^Array has 2 duplicate keys with value ''image'' \(''image'', ''image''\)\.$#'
			identifier: array.duplicateKey
			count: 1
			path: src/lang/en/fields.php

		-
			message: '#^Array has 2 duplicate keys with value ''no_images'' \(''no_images'', ''no_images''\)\.$#'
			identifier: array.duplicateKey
			count: 1
			path: src/lang/en/fields.php

		-
			message: '#^Call to an undefined static method Panneau\\Support\\Facade\:\:routes\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: src/routes.php
