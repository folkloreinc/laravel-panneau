{
    "name": "folklore/laravel-panneau",
    "description": "Admin panels and content management for Laravel: the reference backend of Panneau",
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "panneau"
    ],
    "homepage": "https://github.com/folkloreinc/laravel-panneau",
    "license": "MIT",
    "authors": [
        {
            "name": "Folklore",
            "email": "info@folklore.email",
            "homepage": "http://folkloreinc.ca"
        },
        {
            "name": "David Mongeau-Petitpas",
            "email": "dmp@folklore.email",
            "homepage": "http://mongo.ca",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/fortify": "^1.25"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "league/flysystem-aws-s3-v3": "^3.35",
        "mockery/mockery": "^1.6",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Direct uploads to an S3-compatible disk (panneau.uploads)"
    },
    "autoload": {
        "psr-4": {
            "Panneau\\": "src/Panneau/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Panneau\\Tests\\": "tests/",
            "TestApp\\": "tests/fixture"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Panneau\\ServiceProvider"
            ],
            "aliases": {
                "Panneau": "Panneau\\Support\\Facade"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
